# Neon Postgres connection string (Vercel > Storage > Neon, or neon.tech)
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Admin login. Change both before deploying.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-locally-only"

# Signs the admin session cookie. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"

# Public site URL, used for metadata and OG tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
